model detections {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id           String          @db.Uuid
  severity_level_id Int
  pothole_id        String?         @db.Uuid
  latitude          Decimal         @db.Decimal(9, 6)
  longitude         Decimal         @db.Decimal(9, 6)
  gps_accuracy_m    Decimal?        @db.Decimal(6, 2)
  model_confidence  Decimal         @db.Decimal(5, 4)
  bbox_area_ratio   Decimal         @db.Decimal(6, 4)
  detected_at       DateTime        @db.Timestamptz(6)
  received_at       DateTime        @default(now()) @db.Timestamptz(6)
  potholes          potholes?       @relation(fields: [pothole_id], references: [id], onUpdate: NoAction)
  severity_levels   severity_levels @relation(fields: [severity_level_id], references: [id], onUpdate: NoAction)
  trips             trips           @relation(fields: [trip_id], references: [id], onUpdate: NoAction)

  @@index([latitude, longitude], map: "idx_detections_coordinates")
  @@index([detected_at], map: "idx_detections_detected_at")
  @@index([pothole_id], map: "idx_detections_pothole")
  @@index([severity_level_id], map: "idx_detections_severity")
  @@index([trip_id], map: "idx_detections_trip")
  @@index([detected_at], map: "idx_detections_unclustered", where: raw("(pothole_id IS NULL)"))
}

