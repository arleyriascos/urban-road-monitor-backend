# Copy this file to .env and fill in the real values.
# Never commit the .env file.

# Environment: development | production | test
NODE_ENV=development

# Port where the server listens
PORT=3000

# Neon connection string for the app_user role.
# Local development uses the "development" branch; Render uses "production".
# sslmode=verify-full is what the pg driver already does for "require", and it avoids
# the driver's security warning.
DATABASE_URL=postgresql://app_user:YOUR_PASSWORD@YOUR_NEON_HOST/urban_road_monitor?sslmode=verify-full

# Allowed frontend origins, separated by commas
CORS_ORIGIN=http://localhost:5173

# Shared token for the /internal endpoints that the AI service calls (at least 32 characters).
# Leave it empty to turn those endpoints off: they answer 404.
# Generate it with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It must be the same value as INTERNAL_TOKEN in the AI service. Never write it here.
INTERNAL_TOKEN=

# Address of the AI service that computes routes (locally http://localhost:8000; in Render the
# https:// address of the service). Without it, POST /api/routes answers 503.
AI_SERVICE_URL=

# Client ID of the Google app used to sign people in, for example
# <numbers>-<letters>.apps.googleusercontent.com. It is public (the frontend uses the same
# one), but never write the client secret here. Leave it empty to turn Google sign-in off:
# POST /api/auth/google then answers 503.
GOOGLE_CLIENT_ID=

# E-mail service (Brevo) that sends the links to verify an email and to choose a new password.
# The three go together: without any of them the routes that send e-mail answer 503.
# BREVO_API_KEY is a secret: write it only in the Render panel and in your local .env, never in git.
# MAIL_FROM is a sender verified in Brevo. APP_URL is the address of the frontend (no path):
# the links of the messages lead there.
BREVO_API_KEY=
MAIL_FROM=
# MAIL_FROM_NAME=Urban Road Monitor
APP_URL=

# Optional: how many routes the LRU route cache keeps (default 200).
# ROUTE_CACHE_CAPACITY=200

# Only for the seed:potholes command (local use, never in Render):
# the Neon host of the "development" branch, the only server where test potholes may be created.
SEED_ALLOWED_HOST=

# Only for the tests that need a real PostgreSQL (local use, never in Render).
# It must be a database on this computer whose name ends in _test: the tests empty its tables.
# Connect as the database owner (for example postgres). Without it those tests are skipped.
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/urban_road_monitor_test
