# Copy this file to .env and fill in the real values.
# Never commit the .env file.

# Environment: development | production | test
NODE_ENV=development

# Port where the server listens
PORT=3000

# Neon connection string for the app_user role.
# Local development uses the "development" branch; Render uses "production".
# sslmode=verify-full is what the pg driver already does for "require", and it avoids
# the driver's security warning.
DATABASE_URL=postgresql://app_user:YOUR_PASSWORD@YOUR_NEON_HOST/urban_road_monitor?sslmode=verify-full

# Allowed frontend origins, separated by commas
CORS_ORIGIN=http://localhost:5173

# Shared token for the /internal endpoints that the AI service calls (at least 32 characters).
# Leave it empty to turn those endpoints off: they answer 404.
# Generate it with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It must be the same value as INTERNAL_TOKEN in the AI service. Never write it here.
INTERNAL_TOKEN=

# Only for the seed:potholes command (local use, never in Render):
# the Neon host of the "development" branch, the only server where test potholes may be created.
SEED_ALLOWED_HOST=
