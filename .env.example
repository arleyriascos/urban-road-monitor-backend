# Copy this file to .env and fill in the real values.
# Never commit the .env file.

# Environment: development | production | test
NODE_ENV=development

# Port where the server listens
PORT=3000

# Neon connection string for the app_user role.
# Local development uses the "development" branch; Render uses "main".
DATABASE_URL=postgresql://app_user:YOUR_PASSWORD@YOUR_NEON_HOST/urban_road_monitor?sslmode=require

# Allowed frontend origins, separated by commas
CORS_ORIGIN=http://localhost:5173
